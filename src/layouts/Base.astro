---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, NAME, EMAIL, LINKS, LOCATION, MEDIUM, UMAMI_WEBSITE_ID } from '../consts';
import { url } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  date?: Date;
  noindex?: boolean;
  /** Path to a 1200×630 PNG from src/pages/og/, e.g. '/og/work.png'. */
  ogImage?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  date,
  noindex = false,
  ogImage = '/og/home.png',
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — Software engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(url('/'), Astro.site).href;
const ogImageUrl = new URL(url(ogImage), Astro.site).href;

const isHome = Astro.url.pathname.replace(/\/?$/, '/') === url('/');
const personLd = isHome
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: NAME,
      url: siteUrl,
      jobTitle: 'Software Engineer',
      homeLocation: { '@type': 'Place', name: LOCATION },
      sameAs: [...LINKS.map((l) => l.href), MEDIUM],
    })
  : null;

const nav = [
  { label: 'Home', href: url('/') },
  { label: 'Work', href: url('/work/') },
  { label: 'Writing', href: url('/writing/') },
  { label: 'About', href: url('/about/') },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) =>
  href === url('/') ? path === href : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={NAME} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />
    {personLd && <script type="application/ld+json" set:html={personLd} />}
    <slot name="head" />
    {import.meta.env.PROD && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID}></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <nav aria-label="Main">
          {
            nav.map((item, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </>
            ))
          }
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-links">
        {
          [{ label: EMAIL, href: `mailto:${EMAIL}` }, ...LINKS, { label: 'RSS', href: url('/rss.xml') }].map(
            (l, i, all) => (
              <span class="item">
                <a href={l.href}>{l.label}</a>
                {i < all.length - 1 && <span class="sep" aria-hidden="true">·</span>}
              </span>
            )
          )
        }
        </div>
        <div class="mono" style="margin-top:0.75rem">{NAME}, {new Date().getFullYear()}</div>
      </footer>
    </div>
  </body>
</html>
